#include <algorithm>
#include <iostream>
#include <iterator>
#include <vector>

void input_vector(std::vector<int>& v) {
    int x{};
    std::cout << "Unesite brojeve (0 za kraj): ";
    while (std::cin >> x && x != 0) {
        v.push_back(x);
    }
}

int main() {
    std::vector<int> v;
    input_vector(v);

    if (v.empty()) {
        std::cout << "Vektor je prazan." << std::endl;
        return 0;
    }

    int k{};
    std::cout << "k: ";
    std::cin >> k;
    if (k <= 0) {
        std::cout << "k mora biti > 0." << std::endl;
        return 0;
    }

    auto neg = std::count_if(v.begin(), v.end(), [](int x) { return x < 0; });
    std::cout << "negativnih: " << neg << std::endl;

    auto it = std::find_if(v.begin(), v.end(), [k](int x) { return x % k == 0; });
    if (it != v.end()) {
        std::cout << "prvi visekratnik od " << k << ": " << *it
                  << " (pozicija " << std::distance(v.begin(), it) << ")" << std::endl;
    } else {
        std::cout << "nema visekratnika od " << k << std::endl;
    }

    auto mn = std::min_element(v.begin(), v.end());
    auto mx = std::max_element(v.begin(), v.end());
    std::cout << "min " << *mn << " (pozicija " << std::distance(v.begin(), mn) << "), "
              << "max " << *mx << " (pozicija " << std::distance(v.begin(), mx) << ")"
              << std::endl;

    v.erase(std::remove_if(v.begin(), v.end(), [k](int x) { return x % k == 0; }),
            v.end());

    std::cout << "bez visekratnika:";
    for (int x : v) std::cout << ' ' << x;
    std::cout << std::endl;
}
